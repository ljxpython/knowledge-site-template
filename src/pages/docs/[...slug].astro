---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { getCollectionConfig } from '../../lib/site';

export async function getStaticPaths() {
  const docs = (await getCollection('docs', ({ data }) => data.published))
    .sort((a, b) => {
      const colA = getCollectionConfig(a.data.collection);
      const colB = getCollectionConfig(b.data.collection);
      return colA.order - colB.order || a.data.order - b.data.order;
    });

  return docs.map((doc) => {
    const colConfig = getCollectionConfig(doc.data.collection);
    const collectionDocs = docs.filter((item) => item.data.collection === doc.data.collection
      && (colConfig.sectionMode !== 'collapsible' || item.data.section === doc.data.section));
    const index = collectionDocs.findIndex((item) => item.id === doc.id);

    return {
      params: { slug: `${doc.data.collection}/${doc.id}` },
      props: {
        doc,
        colConfig,
        prev: index > 0 ? collectionDocs[index - 1] : null,
        next: index < collectionDocs.length - 1 ? collectionDocs[index + 1] : null,
      },
    };
  });
}

const { doc, colConfig, prev, next } = Astro.props;
const { Content, headings } = await render(doc);
---

<DocLayout
  id={doc.id}
  collection={doc.data.collection}
  collectionTitle={colConfig.title}
  collectionNotice={colConfig.notice}
  collectionSourceLabel={colConfig.sourceLabel}
  collectionSourceUrl={colConfig.sourceUrl}
  title={doc.data.title}
  description={doc.data.description}
  section={doc.data.section}
  order={doc.data.order}
  source={doc.data.source}
  resources={doc.data.resources}
  headings={headings}
  prev={prev ? { collection: prev.data.collection, id: prev.id, title: prev.data.title, section: prev.data.section } : null}
  next={next ? { collection: next.data.collection, id: next.id, title: next.data.title, section: next.data.section } : null}
>
  <Content />
</DocLayout>
